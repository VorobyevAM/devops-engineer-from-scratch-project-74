FROM node:26-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN chown node:node /app
USER node

# Copy dependency manifests first so this expensive layer is reusable.
COPY --chown=node:node app/package.json app/package-lock.json ./
RUN npm ci

COPY --chown=node:node app/. .

EXPOSE 8080
ENV NODE_ENV=production

RUN make build

CMD ["make", "start"]
